---
import '@styles/Blog.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import KitamiLayout from './KitamiLayout.astro';
import { formatDate, frenchSpacing, tagHref, type Tag } from '@/lib/blog';
import { ids } from '@/lib/structured-data';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: Tag[];
  author?: string;
  image?: ImageMetadata;
}

const { title, description, pubDate, tags = [], author = 'Piki & Co', image } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Cover image for social cards and structured data, resized at build time.
const cover = image ? await getImage({ src: image, width: Math.min(1200, image.width), format: 'webp' }) : undefined;
const coverUrl = cover ? new URL(cover.src, Astro.site).href : undefined;

// The organisation, website and page nodes come from KitamiLayout; this adds the post.
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  url: canonicalUrl,
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
  isPartOf: {
    '@type': 'Blog',
    '@id': ids.blog,
    name: 'Le Blog Ki-tämi',
    url: new URL('/blog/', Astro.site).href,
  },
  // Authors are teams of the company ("L'équipe Piki & Co"), not individual people.
  author: { '@type': 'Organization', name: author, url: new URL('/piki-and-co/', Astro.site).href },
  publisher: { '@id': ids.organization },
  keywords: tags.map((tag) => tag.label).join(', '),
  inLanguage: 'fr-FR',
};
if (coverUrl) schema.image = coverUrl;
---

<KitamiLayout
  title={title}
  description={description}
  image={cover?.src}
  ogType="article"
  breadcrumbs={[
    { name: 'Blog', href: '/blog/' },
    { name: title, href: Astro.url.pathname },
  ]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <article>
    <header class="blog-hero">
      <div class="container">
        <a href="/blog/" class="blog-back">← Tous les articles</a>
        {tags.length > 0 && (
          <ul class="blog-tags" aria-label="Thèmes">
            {tags.map((tag) => (
              <li><a href={tagHref(tag.label)} class="blog-tag">#{tag.label}</a></li>
            ))}
          </ul>
        )}
        <h1 style="margin-top: 1rem;">{frenchSpacing(title)}</h1>
        <p class="blog-meta-line">
          Par {author} · <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </p>
      </div>
    </header>

    <div class="blog-body">
      <div class="container">
        <!-- data-pagefind-body: Pagefind indexes only this block -->
        <div class="blog-article prose" data-pagefind-body>
          <slot />
        </div>
      </div>
    </div>
  </article>
</KitamiLayout>
