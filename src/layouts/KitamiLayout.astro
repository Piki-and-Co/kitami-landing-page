---
import '@styles/Kitami.css';
import { Image, getImage } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import { siteGraph, type PageType } from '@/lib/structured-data';

import logoImage from '@assets/logo.webp';
import logoKitamiDark from '@assets/LogoKitamiLight.webp';
import linkedin from '@assets/Social-Linkedin_White.webp';
import instagram from '@assets/Social-Insta_White.webp';
import tiktok from '@assets/Social-TikTok_White.webp';
import youtube from '@assets/Social-Youtube_White.webp';
import facebook from '@assets/Social-Facebook_White.webp';

interface Props {
  title: string;
  description?: string;
  image?: string;
  breadcrumbs?: Array<{ name: string; href: string }>;
  /** Keep the page out of search results (e.g. confirmation pages). */
  noindex?: boolean;
  /** Open Graph type: "article" for blog posts. */
  ogType?: 'website' | 'article';
  /** schema.org type of the page in the structured data (see src/lib/structured-data.ts). */
  pageType?: PageType;
}

const {
  title,
  description = "Ki-tämi — L'application qui accompagne votre enfant.",
  image,
  breadcrumbs = [],
  noindex = false,
  ogType = 'website',
  pageType = 'WebPage',
} = Astro.props;

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

// "<title> | Ki-tämi", unless the title already names the brand (any spelling).
const fullTitle = /ki-?t[äa]mi/i.test(title) ? title : `${title} | Ki-tämi`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const ogImage = image
  ? new URL(image, Astro.site).href
  : new URL('/assets/LogoKitamiLight.png', Astro.site).href;

// Organisation logo for structured data: Piki & Co logo, exported as PNG at build time.
const orgLogo = await getImage({ src: logoImage, format: 'png' });

const structuredData = JSON.stringify(siteGraph({
  url: canonicalUrl,
  title,
  description,
  pageType,
  logoUrl: new URL(orgLogo.src, Astro.site).href,
  imageUrl: image ? ogImage : undefined,
  breadcrumbs,
}));
---

<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content="Piki & Co" />
		<meta name="robots" content={robots} />
		<title>{fullTitle}</title>
		<BaseHead />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/assets/IcoKitami.png" />
		<link rel="apple-touch-icon" href="/assets/LogoPhoneKitami.png" />
		<link rel="alternate" type="application/rss+xml" title="Le Blog Ki-tämi" href="/rss.xml" />

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="Ki-tämi by Piki & Co" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- JSON-LD -->
		<script type="application/ld+json" set:html={structuredData} />

<script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }

    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'wait_for_update': 500
    });
</script>

  <!-- TarteAuCitron — consentement cookies -->
  <!-- Auto-hébergé : version fixée dans package.json, copiée par integrations/tarteaucitron.mjs -->
  <script src="/vendor/tarteaucitron/tarteaucitron.min.js" is:inline></script>
  <script src="/js/tarteaucitron-init.js" is:inline></script>

<script is:inline>
	(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push(
		{'gtm.start': new Date().getTime(),event:'gtm.js'});
		var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})
	(window,document,'script','dataLayer','GTM-5M6WCL6S');
</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<slot name="head" />
	</head>

	<body>
	<noscript>
	<iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5M6WCL6S" height="0" width="0" style="display:none;visibility:hidden"></iframe>
	</noscript>
		<header>
		</header>
		<nav class="nav">
			<a href="/piki-and-co" target="_blank" rel="noopener noreferrer" class="logo">
				<Image src={logoImage} alt="Piki & Co" width={68} height={48} loading="eager" format="webp"/>
			</a>
			<button class="menu-toggle" aria-label="Ouvrir le menu">
				<span class="bar"></span>
				<span class="bar"></span>
				<span class="bar"></span>
			</button>
			<div class="nav-menu"> 
				<ul class="nav-links">
					<li><a href="/">Accueil</a></li>
					<li><a href="/cps/">Les CPS</a></li>
					<li><a href="/approche/">Innovation</a></li>
					<li><a href="/lejeu/">Le jeu</a></li>
					<li><a href="/piki-and-co/">Le studio</a></li>
					<li><a href="/blog/">Blog</a></li>
				</ul>
			</div>
		</nav>

		<main>
			<slot />
		</main>


		<footer class="footer">
			<p>&copy; {new Date().getFullYear()} Piki&nbsp;&amp;&nbsp;Co — Tous droits réservés</p>
			<nav class="footer-socials" aria-label="Réseaux sociaux">
				<a href="https://www.linkedin.com/company/piki-and-co" target="_blank" rel="noopener noreferrer">
					<Image src={linkedin} alt="Linkedin company page Piki & Co" width={48} height={48} loading="eager" format="webp"/>
				</a>
				<a href="https://www.tiktok.com/@piki.and.co" target="_blank" rel="noopener noreferrer">
					<Image src={tiktok} alt="TikTok profile Piki & Co" width={48} height={48} loading="eager" format="webp"/>
				</a>	
				<a href="https://www.instagram.com/piki.and.co/" target="_blank" rel="noopener noreferrer">
					<Image src={instagram} alt="Instagram profile Piki & Co" width={48} height={48} loading="eager" format="webp"/>
				</a>
				<a href="https://www.facebook.com/61588273838732" target="_blank" rel="noopener noreferrer">
					<Image src={facebook} alt="Facebook profile Piki & Co" width={48} height={48} loading="eager" format="webp"/>
				</a>
				<a href="https://www.youtube.com/@PikiAndCo" target="_blank" rel="noopener noreferrer">
					<Image src={youtube} alt="Youtube chanel Piki & Co" width={48} height={48} loading="eager" format="webp"/>
				</a>
			</nav>
			<p><a href="/legal/mention/">Mentions légales</a> · <a href="/legal/privacy/">Politique de confidentialité</a> · <a href="/legal/cookies/">Cookies</a></p>
		</footer>

		<script>
			const menuToggle = document.querySelector('.menu-toggle');
			const navMenu = document.querySelector('.nav-menu');

			if (menuToggle && navMenu) {
				menuToggle.addEventListener('click', () => {
					navMenu.classList.toggle('is-open');
					menuToggle.classList.toggle('active');
				});
			}
		</script>

	</body>
</html>
