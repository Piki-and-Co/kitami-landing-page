---
import '@styles/Kitami.css';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';

import logoImage from '@assets/logo.webp';
import logoKitamiDark from '@assets/LogoKitamiLight.webp';
import linkedin from '@assets/Social-Linkedin_White.webp';
import instagram from '@assets/Social-Insta_White.webp';
import tiktok from '@assets/Social-TikTok_White.webp';
import youtube from '@assets/Social-Youtube_White.webp';
import facebook from '@assets/Social-Facebook_White.webp';

interface Props {
  title: string;
  description?: string;
  image?: string;
  faqSchema?: string;
  breadcrumbs?: Array<{ name: string; href: string }>;
}

const {
  title,
  description = "Ki-tämi — L'application qui accompagne votre enfant.",
  image,
  faqSchema,
  breadcrumbs = [],
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumbSchema = breadcrumbs.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": new URL('/', Astro.site).href },
    ...breadcrumbs.map((crumb, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": crumb.name,
      "item": new URL(crumb.href, Astro.site).href,
    })),
  ],
}) : null;
const ogImage = image
  ? new URL(image, Astro.site).href
  : new URL('/assets/LogoKitamiLight.png', Astro.site).href;

const appSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Ki-tämi",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Web, iOS, Android",
  "description": "Application éducative qui accompagne les enfants de 4 à 10 ans dans le développement des compétences psychosociales via des jeux vidéo immersifs et engageants.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
  "author": {
    "@type": "Organization",
    "name": "Piki & Co",
    "url": "https://piki-and-co.com",
  },
  "url": "https://ki-tami.com/",
});
---

<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content="Piki & Co" />
		<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
		<title>{title} | Ki-tämi</title>
		<BaseHead />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/assets/IcoKitami.png" />
		<link rel="apple-touch-icon" href="/assets/LogoPhoneKitami.png" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={`${title} | Ki-tämi`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="Ki-tämi by Piki & Co" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | Ki-tämi`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- JSON-LD -->
		<script type="application/ld+json" set:html={appSchema} />
		{breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema} />}

<script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }

    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'wait_for_update': 500
    });
</script>

  <!-- TarteAuCitron — consentement cookies -->
  <script src="https://cdn.jsdelivr.net/npm/tarteaucitronjs@latest/tarteaucitron.js" is:inline></script>
  <script src="/js/tarteaucitron-init.js" is:inline></script>

<script is:inline>
	(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push(
		{'gtm.start': new Date().getTime(),event:'gtm.js'});
		var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})
	(window,document,'script','dataLayer','GTM-5M6WCL6S');
</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<slot name="head" />
		{faqSchema && <script type="application/ld+json" set:html={faqSchema} />}
	</head>

	<body>
	<noscript>
	<iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5M6WCL6S" height="0" width="0" style="display:none;visibility:hidden"></iframe>
	</noscript>
		<header>
		</header>
		<nav class="nav">
			<a href="https://piki-and-co.com/" target="_blank" rel="noopener noreferrer" class="logo">
				<Image src={logoImage} alt="Piki & Co" width={68} height={48} loading="eager" format="webp"/>
			</a>
			<button class="menu-toggle" aria-label="Ouvrir le menu">
				<span class="bar"></span>
				<span class="bar"></span>
				<span class="bar"></span>
			</button>
			<div class="nav-menu"> 
				<ul class="nav-links">
					<li><a href="/">Accueil</a></li>
					<li><a href="/cps">Les CPS</a></li>
					<li><a href="/approche">Innovation</a></li>
					<li><a href="/lejeu">Le jeu</a></li>
				</ul>
			</div>
		</nav>

		<main>
			<slot />
		</main>


		<footer class="footer">
			<p>&copy; {new Date().getFullYear()} Piki&nbsp;&amp;&nbsp;Co — Tous droits réservés</p>
			<nav class="footer-socials" aria-label="Réseaux sociaux">
				<a href="https://www.linkedin.com/company/piki-and-co" target="_blank" rel="noopener noreferrer">
					<Image src={linkedin} alt="Linkedin company page Piki & Co" width={48} height={48} loading="eager" format="webp"/>
				</a>
				<a href="https://www.tiktok.com/@piki.and.co" target="_blank" rel="noopener noreferrer">
					<Image src={tiktok} alt="TikTok profile Piki & Co" width={48} height={48} loading="eager" format="webp"/>
				</a>	
				<a href="https://www.instagram.com/piki.and.co/" target="_blank" rel="noopener noreferrer">
					<Image src={instagram} alt="Instagram profile Piki & Co" width={48} height={48} loading="eager" format="webp"/>
				</a>
				<a href="https://www.facebook.com/61588273838732" target="_blank" rel="noopener noreferrer">
					<Image src={facebook} alt="Facebook profile Piki & Co" width={48} height={48} loading="eager" format="webp"/>
				</a>
				<a href="https://www.youtube.com/@PikiAndCo" target="_blank" rel="noopener noreferrer">
					<Image src={youtube} alt="Youtube chanel Piki & Co" width={48} height={48} loading="eager" format="webp"/>
				</a>
			</nav>
			<p><a href="/legal/mention">Mentions légales</a> · <a href="/legal/privacy">Politique de confidentialité</a> · <a href="/legal/cookies">Cookies</a></p>
		</footer>

		<script>
			const menuToggle = document.querySelector('.menu-toggle');
			const navMenu = document.querySelector('.nav-menu');

			if (menuToggle && navMenu) {
				menuToggle.addEventListener('click', () => {
					navMenu.classList.toggle('is-open');
					menuToggle.classList.toggle('active');
				});
			}
		</script>

	</body>
</html>
