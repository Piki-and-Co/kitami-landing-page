---
/*
 * Accueil — proof of concept d'après le prototype Lovable du CMO
 * (https://lovable.dev/preview/FrcsinskkN63aEM3ZxMck3scYg2HXXZA, relevé le 2026-11-05).
 *
 * - Textes : repris mot pour mot du prototype.
 * - Couleurs / espacements / breakpoints : repris de la feuille de style servie par le prototype
 *   (tokens oklch + classes Tailwind), traduits en CSS scopé à cette page.
 * - Polices : celles du projet (Caveat Brush pour l'affichage, Montserrat pour le texte)
 *   à la place de Fredoka / Raleway utilisées par le prototype.
 * - Navigation et pied de page (mentions légales, confidentialité, cookies) : KitamiLayout.
 * - Tout ce que le prototype laisse vide est marqué TODO(maintainer), visible sur la page.
 */
import KitamiLayout from '@/layouts/KitamiLayout.astro';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import imgLandingPage from '@assets/LandingPage.webp';
import logoKitamiLight from '@assets/LogoKitamiLight.webp';
import imgJeuVideo from '@assets/KitamiJeuVideo.webp';
import imgJeuPlateau from '@assets/KitamiJeuPlateau.webp';
import imgLivretParents from '@assets/KitamiLivretParents.webp';
import imgAppliComp from '@assets/KitamiAppliComp.webp';
import posterVideo1 from '@assets/videos/JeuVideoKitami-Demo.webp';
import posterVideo2 from '@assets/videos/PrixLaurenceSchmoll.webp';

const stats = [
	{ value: "10 ans", label: "de recherche académique française" },
	{ value: "+ 70 enfants", label: "nous ont aidé à développer Ki-tämi" },
	{ value: "Prix de l'innovation 2026", label: "décerné par le Pôle Universitaire d'Innovation Alsace" },
	{ value: "DeepTech", label: "Label décerné en 2025 par la Banque Pour L'Innovation (BPI)" },
];

const supports = [
	{ title: "Un jeu vidéo", image: imgJeuVideo },
	{ title: "Un livret pour les adultes", image: imgLivretParents },
	{ title: "Une application compagnon pour les parents", image: imgAppliComp },
	{ title: "Un jeu de plateau", image: imgJeuPlateau },
];

const reasons = [
	"De 4 et 10 ans est une période cruciale de la construction de soi et du rapport aux autres.",
	"C'est à cet âge que l'apprentissage des langues est le plus facile et le plus efficace.",
	"Avec un usage raisonné, les écrans deviennent un outil éducatif puissant.",
];

// Vidéos auto-hébergées, encodées en local hors dépôt (H.264 + AAC, faststart) depuis le master,
// qui n'est jamais versionné. MP4 dans public/videos/, affiche dans src/assets/videos/.
// Sans src : carte « à venir » du prototype.
type Video = { label: string; src?: string; poster?: ImageMetadata; width?: number; height?: number };
const videoList: Video[] = [
	{ label: "Ki-tämi en action", src: "/videos/kitami-demo-1.mp4", poster: posterVideo1, width: 608, height: 1080 },
	{ label: "Prix de l'Innovation 2026", src: "/videos/PrixLaurenceSchmoll.mp4", poster: posterVideo2, width: 1280, height: 720 },
	{ label: "Vidéo 3" },
];
// Affiche du lecteur (pop-in) : URL WebP optimisée, chargée seulement à l'ouverture.
const videos = await Promise.all(videoList.map(async (v) => ({
	...v,
	posterUrl: v.poster ? (await getImage({ src: v.poster, format: 'webp' })).src : undefined,
})));

// Ordre et libellés du prototype. URLs reprises de KitamiLayout.astro quand elles existent.
// const socials: Array<{ name: string; href: string | null }> = [
// 	{ name: "Instagram", href: "https://www.instagram.com/piki.and.co/" },
// 	{ name: "Facebook", href: "https://www.facebook.com/61588273838732" },
// 	{ name: "WhatsApp", href: null }, // TODO(maintainer): aucune URL WhatsApp dans le projet ni dans le prototype
// 	{ name: "YouTube", href: "https://www.youtube.com/@PikiAndCo" },
// 	{ name: "LinkedIn", href: "https://www.linkedin.com/company/piki-and-co" },
// ];
---

<KitamiLayout
	title="Le jeu multi-support des 4-10 ans"
	description="Ki-Tämi : jeu vidéo, jeu de plateau et livret de l'adulte pour renforcer les compétences humaines des enfants par leur éveil à l'anglais."
>
	<div class="accueil">

		<!-- Hero -->
		<section class="hero">
			<div class="hero-container">
				<div>
					<h1 class="hero-logo">
						<Image src={logoKitamiLight} alt="Ki-Tämi" width={965} height={465} loading="eager" format="webp" />
					</h1>
					<p class="hero-tagline">
					Le 1<sup>er</sup> jeu narratif multi-support qui renforce les compétences humaines de vos enfants,
						en les éveillant à l'anglais
					</p>
				</div>
				<div class="hero-image-container">
					<div class="hero-image-wrapper">
						<Image src={imgLandingPage} alt="Rejoignez Ki-tämi dans ses aventures !"
						width={8268} height={5374} loading="eager" format="webp"/>
					</div>
				</div>
			</div>


			<div class="stats">
				{stats.map((s) => (
					<div class="stat">
						<div class="stat-value">{s.value}</div>
						<div class="stat-label">{s.label}</div>
					</div>
				))}
			</div>
		</section>

		<!-- Crowdfunding -->
		<section class="block block--center">
			<p class="title title--lead">Donnez vie à Ki-tämi avec nous !</p>
			<a href="https://app.mymoojo.com/project/ki-tami" class="btn-crowdfunding" data-todo="crowdfunding-url">Participez à notre campagne de crowdfunding !</a>
		</section>

		<!-- Ki-Tämi, c'est : -->
		<section class="block block--wide">
			<h2 class="title">Ki-Tämi, c'est :</h2>
			<div class="supports">
				{supports.map((s) => (
					<figure class="support">
						<Image src={s.image} alt={s.title} widths={[400, 800]} sizes="(min-width: 48rem) 50vw, 100vw" format="webp" />
						<figcaption>{s.title}</figcaption>
					</figure>
				))}
			</div>
		</section>

		<!-- Pourquoi c'est important ? -->
		<section class="block block--narrow">
			<h2 class="title">Pourquoi c'est important ?</h2>
			<ol class="reasons">
				{reasons.map((r, i) => (
					<li><span class="reason-num" aria-hidden="true">{i + 1}</span>{r}</li>
				))}
			</ol>
		</section>

		<!-- Vidéos -->
		<section class="block block--wide">
			<h2 class="title">Découvrez Ki-Tämi en vidéo</h2>
			<div class="videos">
				{videos.map((v) => v.src && v.poster ? (
					<figure class="video">
						<!-- Lien vers le MP4 : sans JS, le navigateur lit le fichier ; avec JS, ouverture en pop-in. -->
						<a
							class="video-trigger"
							href={v.src}
							aria-haspopup="dialog"
							data-video-label={v.label}
							data-video-poster={v.posterUrl}
							data-video-width={v.width}
							data-video-height={v.height}
						>
							<Image src={v.poster} alt="" class="video-thumb" widths={[400, 800, 1200]} sizes="(min-width: 48rem) min(31vw, 22rem), min(100vw, 22rem)" format="webp" />
							<span class="play" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg>
							</span>
							<span class="video-caption">{v.label}</span>
						</a>
					</figure>
				) : (
					<figure class="video">
						<div class="video-placeholder">
							<span class="play" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg>
							</span>
							<span class="video-label">{v.label} — à venir</span>
						</div>
					</figure>
				))}
			</div>

			<!-- Lecteur en pop-in : src et affiche posés au clic seulement, rien n'est téléchargé avant. -->
			<dialog class="video-dialog">
				<button type="button" class="video-dialog-close" aria-label="Fermer la vidéo">
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
				</button>
				<video controls playsinline preload="none"></video>
			</dialog>
		</section>

		<!-- Newsletter -->
		<!-- Simple lien vers /inscription, qui porte le formulaire Brevo (champs, consentement RGPD, reCAPTCHA). -->
		<section class="block block--newsletter">
			<div class="newsletter">
				<p class="title title--lead">Vous souhaitez vous inscrire à notre newsletter ?</p>
				<a class="newsletter-cta" href="/inscription/">Inscrivez-vous</a>
			</div>
		</section>

		<!-- Réseaux -->
		<!--<nav class="socials" aria-label="Réseaux sociaux">-->
		<!--	{socials.map((s) => s.href-->
		<!--		? <a href={s.href} target="_blank" rel="noopener noreferrer">{s.name}</a>-->
		<!--		: <a href="#" data-todo="social-url">{s.name} <span class="todo todo&#45;&#45;inline">TODO(maintainer) : URL</span></a>-->
		<!--	)}-->
		<!--</nav>-->

	</div>
</KitamiLayout>

<script>
	// Vidéos : clic sur une carte -> pop-in (<dialog> natif : focus piégé, Échap ferme,
	// focus rendu à la carte), lecture avec le son. Fermeture -> pause.
	const dialog = document.querySelector<HTMLDialogElement>('.video-dialog');
	const player = dialog?.querySelector<HTMLVideoElement>('video');
	if (dialog && player) {
		const setRatio = (w: number, h: number) => {
			if (w > 0 && h > 0) player.style.setProperty('--video-ratio', `${w} / ${h}`);
			else player.style.removeProperty('--video-ratio');
		};
		player.addEventListener('loadedmetadata', () => {
			if (player.videoWidth && player.videoHeight) setRatio(player.videoWidth, player.videoHeight);
		});
		document.querySelectorAll<HTMLAnchorElement>('.video-trigger').forEach((trigger) => {
			trigger.addEventListener('click', (e) => {
				e.preventDefault();
				const { videoLabel, videoPoster, videoWidth, videoHeight } = trigger.dataset;
				if (player.getAttribute('src') !== trigger.getAttribute('href')) {
					player.src = trigger.getAttribute('href') ?? '';
					player.poster = videoPoster ?? '';
					// Proportions de la vidéo -> taille du lecteur (voir .video-dialog video dans le CSS).
					// width/height de videoList donnent la taille dès l'ouverture ; loadedmetadata la corrige
					// ensuite d'après le fichier réel si elles sont fausses ou absentes.
					setRatio(Number(videoWidth), Number(videoHeight));
				}
				dialog.setAttribute('aria-label', videoLabel ?? '');
				dialog.showModal();
				// Le clic est un geste utilisateur : lecture avec le son autorisée. Si le navigateur
				// refuse quand même, les contrôles natifs restent disponibles.
				player.play().catch(() => {});
			});
		});
		dialog.querySelector('.video-dialog-close')?.addEventListener('click', () => dialog.close());
		// Clic sur le fond (hors de la vidéo) -> fermeture.
		dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
		dialog.addEventListener('close', () => player.pause());
	}
</script>

<style>
	/* Tokens du prototype (feuille de style Lovable servie, valeurs oklch d'origine). */
	.accueil {
		--night-background:  oklch(26% .1 320);
		--night-foreground:  oklch(98% .01 320);
		--night-card:        oklch(32% .12 320);
		--night-muted-fg:    oklch(85% .04 320);
		--night-border:      oklch(100% 0 0 / .15);
		--night-input:       oklch(100% 0 0 / .2);
		--night-primary:     oklch(76% .17 340);
		--night-primary-fg:  oklch(99% 0 0);
		--night-secondary:   oklch(85% .1 220);
		--night-secondary-fg: oklch(25% .1 320);
		--night-accent:      oklch(88% .15 90);
		--night-accent-fg:   oklch(25% .1 320);
		--night-radius:      calc(1.25rem + 8px);
		--night-glow:        0 20px 50px -15px color-mix(in oklab, var(--night-primary) 60%, transparent);

		background-color: var(--night-background);
		background-image: radial-gradient(ellipse at 50% 40%, oklch(40% .16 325), oklch(22% .09 315) 75%);
		color: var(--night-foreground);
		font-family: var(--font-body);
		line-height: 1.5;
		padding-bottom: 3rem;
	}

	/* Caveat Brush n'existe qu'en graisse normale : on garde 400 pour éviter le faux gras. */
	.title,
	.stat-value,
	.support figcaption,
	.btn-crowdfunding,
	.reason-num,
	.video-label,
	.newsletter-cta {
		font-family: var(--font-display);
		font-weight: 400;
	}

	/* --- Hero --- */
	.hero {
		max-width: 64rem;
		margin: 0 auto;
		padding: 4rem 1.5rem 3rem;
		text-align: center;
	}
	.hero-logo {
		display: flex;
		justify-content: center;
	}
	.hero-logo img {
		width: 100%;
		max-width: 24rem;
		height: auto;
		filter: drop-shadow(0 18px 45px rgba(0, 0, 0, 0.45));
	}
	.hero-tagline {
		max-width: 48rem;
		margin: 2rem auto 0;
		font-size: 1.5rem;
		line-height: 1.375;
	}
	/* Layout en grille : 2 colonnes sur PC, 1 seule colonne empilée sur mobile */
	.hero-container {
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		align-items: center;
		width: 100%;
		max-width: 24rem;
	}

	@media (min-width: 48rem) {
		.hero-container {
			grid-template-columns: 0.9fr 1.1fr; /* La colonne de texte est légèrement plus large */
			max-width: 90rem;
		}
	}
	/* Éléments de droite (Image et Badge) */
	.hero-image-container {
		display: flex;
		justify-content: center;
	}

	.hero-image-wrapper {
		position: relative;
		width: 100%;
		max-width: 180rem;
	}

	.hero-image-wrapper img {
		width: 100%;
		height: auto;
		border-radius: 1.25rem;
		display: block;
	}
	.stats {
		display: grid;
		gap: 1rem;
		margin-top: 3rem;
	}
	.stat {
		border: 1px solid var(--night-border);
		border-radius: var(--night-radius);
		background: color-mix(in oklab, var(--night-card) 50%, transparent);
		padding: 1.25rem;
	}
	.stat-value {
		font-size: 1.25rem;
		line-height: 1.4;
		color: var(--night-primary);
	}
	.stat-label {
		margin-top: 0.25rem;
		font-size: 0.875rem;
		color: var(--night-muted-fg);
	}

	/* --- Blocs --- */
	.block {
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}
	.block--wide   { max-width: 72rem; }
	.block--narrow { max-width: 56rem; padding-block: 4rem; }
	.block--newsletter { max-width: 56rem; }
	.block--center { text-align: center; }

	.title {
		text-align: center;
		font-size: 2.25rem;
		line-height: 1.11;
		color: inherit;
	}
	.title--lead { font-size: 1.875rem; line-height: 1.2; }

	/* --- Supports --- */
	.supports {
		display: grid;
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.support {
		position: relative;
		overflow: hidden;
		border: 4px solid var(--night-foreground);
		border-radius: var(--night-radius);
		box-shadow: var(--night-glow);
	}
	.support img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(.4, 0, .2, 1);
	}
	.support:hover img { transform: scale(1.05); }
	.support figcaption {
		position: absolute;
		inset: auto 0 0 0;
		padding: 1rem;
		background: color-mix(in oklab, var(--night-background) 70%, transparent);
		text-align: center;
		font-size: 1.5rem;
		line-height: 1.33;
	}

	/* --- Crowdfunding --- */
	.btn-crowdfunding {
		display: inline-block;
		margin-top: 2rem;
		padding: 1.5rem 2.5rem;
		border-radius: 9999px;
		background: var(--night-primary);
		color: var(--night-primary-fg);
		font-size: 1.5rem;
		line-height: 1.33;
		text-decoration: none;
		box-shadow: var(--night-glow);
		transition: transform 0.15s cubic-bezier(.4, 0, .2, 1);
	}
	.btn-crowdfunding:hover { transform: scale(1.05); }

	/* --- Raisons --- */
	.reasons {
		list-style: none;
		margin-top: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.reasons li {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 1.25rem;
		border-radius: var(--night-radius);
		background: color-mix(in oklab, var(--night-card) 60%, transparent);
		font-size: 1.125rem;
		line-height: 1.55;
	}
	.reason-num {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 9999px;
		background: var(--night-secondary);
		color: var(--night-secondary-fg);
		font-size: 1.25rem;
	}

	/* --- Vidéos --- */
	/* 3 cartes carrées côte à côte (1 colonne sur mobile, cartes plafonnées à 22rem) :
	   le carré accueille aussi bien une affiche verticale qu'horizontale.
	   Proportions des cartes : --video-card-ratio (1 = carré ; essayer 4 / 5 ou 5 / 4). */
	.videos {
		--video-card-ratio: 1;
		display: grid;
		grid-template-columns: minmax(0, 22rem);
		justify-content: center;
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.video {
		overflow: hidden;
		border: 4px solid var(--night-foreground);
		border-radius: var(--night-radius);
		background: color-mix(in oklab, var(--night-card) 40%, transparent);
		box-shadow: var(--night-glow);
	}
	.video-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		aspect-ratio: var(--video-card-ratio);
		width: 100%;
		background-image: radial-gradient(ellipse at 50% 40%, oklch(40% .16 325), oklch(22% .09 315) 75%);
	}
	.play {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 4rem;
		height: 4rem;
		border-radius: 9999px;
		background: color-mix(in oklab, var(--night-primary) 90%, transparent);
		color: var(--night-primary-fg);
		box-shadow: var(--night-glow);
	}
	.video-label {
		font-size: 1.125rem;
		color: var(--night-muted-fg);
	}

	/* Carte vidéo cliquable : même cadre et dégradé que le placeholder, affiche entière centrée
	   (verticale ou horizontale, le dégradé comble le reste), légende en bandeau. */
	.video-trigger {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: var(--video-card-ratio);
		width: 100%;
		color: inherit;
		text-decoration: none;
		background-image: radial-gradient(ellipse at 50% 40%, oklch(40% .16 325), oklch(22% .09 315) 75%);
	}
	.video-thumb {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.video-trigger .play {
		position: relative;
		transition: transform 0.2s cubic-bezier(.4, 0, .2, 1);
	}
	.video-trigger:hover .play,
	.video-trigger:focus-visible .play { transform: scale(1.1); }
	.video-trigger:focus-visible {
		outline: 3px solid var(--night-accent);
		outline-offset: -3px;
	}
	.video-caption {
		position: absolute;
		inset: auto 0 0 0;
		padding: 0.5rem 0.75rem;
		background: color-mix(in oklab, var(--night-background) 70%, transparent);
		text-align: center;
		font-size: 1.125rem;
		line-height: 1.33;
	}

	/* Pop-in vidéo (<dialog>) : sa taille suit celle du lecteur, voir .video-dialog video. */
	.video-dialog {
		padding: 0;
		overflow: hidden;
		max-width: 90vw;
		max-height: 90dvh;
		border: 4px solid var(--night-foreground);
		border-radius: var(--night-radius);
		background: #000;
		box-shadow: var(--night-glow);
	}
	.video-dialog::backdrop {
		background: color-mix(in oklab, var(--night-background) 85%, transparent);
	}
	/* Lecteur aussi grand que possible sans déformer ni bandes noires, vidéo verticale ou horizontale :
	   au plus 85 % de la hauteur d'écran (et 50rem), au plus 90vw de large moins les 2 × 4px de bordure.
	   --video-ratio (« largeur / hauteur ») est posé au clic d'après data-video-width/height. */
	.video-dialog video {
		--video-max-h: min(85dvh, 50rem);
		display: block;
		aspect-ratio: var(--video-ratio, 16 / 9);
		width: min(calc(90vw - 8px), calc(var(--video-max-h) * var(--video-ratio, 16 / 9)));
		height: auto;
	}
	.video-dialog-close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 9999px;
		background: color-mix(in oklab, var(--night-background) 75%, transparent);
		color: var(--night-foreground);
		cursor: pointer;
	}
	.video-dialog-close:focus-visible {
		outline: 3px solid var(--night-accent);
		outline-offset: 2px;
	}
	/* Page figée derrière la pop-in. */
	:global(html:has(.video-dialog[open])) { overflow: hidden; }

	/* --- Newsletter --- */
	/* Titre et bouton : empilés et centrés sur mobile, sur une ligne (groupe centré) dès 48rem. */
	.newsletter {
